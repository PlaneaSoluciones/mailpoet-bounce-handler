includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 5
    phpVersion: 80100
    bootstrapFiles:
        - phpstan-bootstrap.php
    paths:
        - mailpoet-bounce-handler.php
        - includes/
        - admin/
        - uninstall.php
    excludePaths:
        - vendor/
    ignoreErrors:
        -
            identifier: method.notFound
            message: '#enableReleaseAssets\(\)#'
            path: mailpoet-bounce-handler.php
