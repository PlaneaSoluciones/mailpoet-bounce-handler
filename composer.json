{
    "name": "planeasoluciones/mailpoet-bounce-handler",
    "type": "wordpress-plugin",
    "description": "Gestión automática de bounces IMAP para MailPoet 3",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Planea Soluciones",
            "homepage": "https://planeasoluciones.com"
        }
    ],
    "require": {
        "php": ">=8.2,<8.6",
        "yahnis-elsts/plugin-update-checker": "^6.0,<7.0"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.13.6,<4.0",
        "wp-coding-standards/wpcs": "^3.4.1,<4.0",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2.1,<2.0",
        "phpstan/phpstan": "^2.3.7,<3.0",
        "szepeviktor/phpstan-wordpress": "^2.0.4,<3.0",
        "php-stubs/wordpress-stubs": "^7.1.2,<8.0"
    },
    "scripts": {
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "phpstan": "php scripts/phpstan-run.php",
        "check": ["@lint", "@phpstan"],
        "post-install-cmd": ["git config core.hooksPath .githooks || true"],
        "post-update-cmd": ["git config core.hooksPath .githooks || true"]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
